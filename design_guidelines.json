{
  "project_overview": {
    "name": "Kodenzo Labs",
    "type": "premium_corporate_website",
    "tone": "Calm confidence, engineering-grade precision blended with AI-future warmth. Premium, quiet, deliberate.",
    "tech_stack": [
      "React 19",
      "React Router v7",
      "Tailwind CSS",
      "Framer Motion",
      "Lucide React",
      "Shadcn UI"
    ]
  },
  "design_system": {
    "theme_strategy": "Sophisticated Dual-Tone Hybrid. The navbar, hero sections, and footer use an Obsidian Dark theme to natively house the teal/black logo. Content sections transition to a clean, highly breathable Off-White Light theme. This reconciles the brand tension while maintaining a Stripe/Linear aesthetic.",
    "colors": {
      "dark_mode": {
        "background": "#0A0A0A",
        "surface": "#111111",
        "surface_glass": "rgba(10, 10, 10, 0.7)",
        "text_primary": "#FFFFFF",
        "text_muted": "#A1A1AA",
        "border": "rgba(255, 255, 255, 0.1)"
      },
      "light_mode": {
        "background": "#F8FAFC",
        "surface": "#FFFFFF",
        "surface_glass": "rgba(255, 255, 255, 0.7)",
        "text_primary": "#111827",
        "text_muted": "#6B7280",
        "border": "rgba(17, 24, 39, 0.05)"
      },
      "brand": {
        "primary_blue": "#335EEA",
        "primary_teal": "#35b7a1",
        "gradient_accent": "linear-gradient(135deg, #35b7a1 0%, #335EEA 100%)",
        "gradient_text": "bg-clip-text text-transparent bg-gradient-to-r from-[#35b7a1] to-[#335EEA]"
      }
    },
    "typography": {
      "heading_font": "Cabinet Grotesk, system-ui, sans-serif",
      "body_font": "Geist, system-ui, sans-serif",
      "scale": {
        "h1": "text-5xl sm:text-6xl lg:text-7xl font-black tracking-tighter",
        "h2": "text-4xl sm:text-5xl font-extrabold tracking-tight",
        "h3": "text-2xl sm:text-3xl font-bold tracking-tight",
        "h4": "text-xl sm:text-2xl font-semibold",
        "body_lg": "text-lg sm:text-xl leading-relaxed",
        "body": "text-base leading-relaxed",
        "label": "text-sm font-medium tracking-wide uppercase"
      }
    },
    "spacing_and_radius": {
      "card_radius": "rounded-[24px]",
      "navbar_radius": "rounded-[999px]",
      "button_radius": "rounded-[999px]",
      "section_padding": "py-24 sm:py-32"
    },
    "effects": {
      "shadow_premium": "shadow-[0_8px_30px_rgb(0,0,0,0.04)]",
      "shadow_glow_blue": "shadow-[0_0_40px_-10px_rgba(51,94,234,0.3)]",
      "shadow_glow_teal": "shadow-[0_0_40px_-10px_rgba(53,183,161,0.3)]",
      "glass_dark": "backdrop-blur-xl bg-[#0A0A0A]/70 border border-white/10",
      "glass_light": "backdrop-blur-xl bg-white/70 border border-gray-200"
    }
  },
  "animation_system": {
    "framer_motion": {
      "fade_up": { "initial": { "opacity": 0, "y": 20 }, "whileInView": { "opacity": 1, "y": 0 }, "viewport": { "once": true, "margin": "-100px" } },
      "stagger_container": { "hidden": { "opacity": 0 }, "show": { "opacity": 1, "transition": { "staggerChildren": 0.1 } } },
      "hover_lift": { "whileHover": { "y": -8, "transition": { "duration": 0.3, "ease": "easeOut" } } },
      "button_tap": { "whileTap": { "scale": 0.98 } }
    },
    "transitions": {
      "spring_smooth": { "type": "spring", "stiffness": 100, "damping": 20 },
      "ease_custom": [0.16, 1, 0.3, 1]
    }
  },
  "component_recipes": {
    "navbar": {
      "structure": "Fixed top-4 left-1/2 -translate-x-1/2 w-[95%] max-w-7xl z-50 transition-all duration-300",
      "styling": "rounded-[999px] backdrop-blur-xl bg-[#0A0A0A]/80 border border-white/10 px-6 py-4 flex justify-between items-center",
      "links": "text-white/80 hover:text-white transition-colors text-sm font-medium",
      "cta": "bg-gradient-to-r from-[#35b7a1] to-[#335EEA] text-white px-6 py-2 rounded-[999px] font-medium hover:shadow-glow_teal transition-all"
    },
    "hero_dark": {
      "styling": "min-h-[90vh] bg-[#0A0A0A] flex flex-col justify-center relative overflow-hidden text-white pt-32",
      "background_elements": "Absolute positioned blurred blobs. Top right: bg-[#335EEA]/20 w-[500px] h-[500px] blur-[120px] rounded-full. Bottom left: bg-[#35b7a1]/20 w-[400px] h-[400px] blur-[100px] rounded-full.",
      "content": "Centered text layout. H1 with gradient text span on key words. Two CTAs (Primary Gradient, Secondary Outline)."
    },
    "bento_card": {
      "styling": "bg-white rounded-[24px] p-8 border border-gray-100 shadow-premium group relative overflow-hidden",
      "hover_effect": "Framer motion hover lift. Icon container scales up slightly. Subtle gradient border reveal on hover.",
      "content": "Lucide icon (stroke #335EEA), H3 title, text-muted description, 'Learn more' link with arrow."
    },
    "footer": {
      "styling": "bg-[#0A0A0A] text-white pt-24 pb-12 border-t border-white/10",
      "layout": "Grid cols-1 md:grid-cols-4 gap-12. Brand column with Teal logo. Quick links, Services, Legal.",
      "bottom": "Flex justify-between items-center pt-8 border-t border-white/10 text-white/50 text-sm"
    }
  },
