  "technical_rules": {
    "file_extensions": "All files must be .js or .jsx, NOT .tsx. The environment uses Create React App.",
    "routing": "Use React Router v7. Implement a Layout wrapper component for the Navbar and Footer to persist across all 19 pages.",
    "testing": "All interactive and key informational elements MUST include a `data-testid` attribute (e.g., data-testid='hero-cta-button').",
    "accessibility": "Ensure high contrast, aria-labels on icon buttons, semantic HTML5 structure.",
    "components": "Use Shadcn UI where applicable (e.g., Accordion for FAQs, Form elements), but heavily customize to match the exact spacing and radius (24px) guidelines.",
    "icons": "Use Lucide React. No emojis."
  }
